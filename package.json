{
  "name": "sarue-unb",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "lint:all": "pnpm run typecheck && pnpm run lint && pnpm run lint:rust",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:all": "pnpm run test && pnpm run test:rust",
    "check:all": "pnpm run lint:all && pnpm run test:all",
    "check": "pnpm run check:all",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "tauri": "node scripts/tauri-cli.mjs",
    "tauri:dev": "node scripts/tauri-cli.mjs dev",
    "dev:app": "node scripts/tauri-cli.mjs dev",
    "scrape:grade": "node --experimental-strip-types src/scrapers/grade-scraper.ts",
    "scrape:courses": "node --experimental-strip-types src/scrapers/courses-scraper.ts",
    "scrape:calendar": "node --experimental-strip-types src/scrapers/calendar-scraper.ts",
    "scrape:professors": "node --experimental-strip-types src/scrapers/professors-scraper.ts",
    "scrape:all": "pnpm run scrape:grade && pnpm run scrape:courses && pnpm run scrape:calendar",
    "data:split-curricula": "node scripts/split-curricula.mjs",
    "seeds": "node scripts/seed-dev-db.mjs",
    "seed": "node scripts/seed-dev-db.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dagrejs/dagre": "^3.1.1",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "@tauri-apps/plugin-stronghold": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@tauri-apps/plugin-window-state": "~2.5.0",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.16.0",
    "motion": "^14.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
