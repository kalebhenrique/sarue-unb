{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Saruê UnB",
  "version": "0.3.1",
  "identifier": "br.unb.sarue",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Saruê UnB",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://docs.google.com https://sarue-unb-site.vercel.app; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDNEVEQTNFMkJGNzYyRkIKUldUN1l2Y3JQdHBPN0xrK05YR2J3bmwzVlh1dzN2c1NwRzloZC9sQjhubHB6cGt5L0c2THpNNDQK",
      "endpoints": [
        "https://github.com/kalebhenrique/sarue-unb/releases/latest/download/latest.json"
      ]
    }
  }
}
