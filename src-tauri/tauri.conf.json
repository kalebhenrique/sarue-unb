{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Saruê UnB",
  "version": "0.5.2",
  "identifier": "br.unb.sarue",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "Saruê UnB",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://docs.google.com https://www.sarue.app.br https://sarue.app.br https://sarue-unb-site.vercel.app; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb", "app", "dmg"],
    "createUpdaterArtifacts": true,
    "publisher": "Kaleb Henrique",
    "homepage": "https://www.sarue.app.br",
    "copyright": "Copyright (c) 2026 Kaleb Henrique Silva Pereira",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "category": "Education",
    "shortDescription": "Assistente acadêmico para estudantes da UnB",
    "longDescription": "Organize tarefas do Aprender 3 e SIGAA, consulte o cardápio do RU, simule notas e faltas e monte sua grade horária da UnB.",
    "linux": {
      "deb": {
        "section": "education",
        "priority": "optional",
        "files": {
          "/usr/share/metainfo/br.unb.sarue.metainfo.xml": "linux/br.unb.sarue.metainfo.xml"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/metainfo/br.unb.sarue.metainfo.xml": "linux/br.unb.sarue.metainfo.xml"
        }
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDNEVEQTNFMkJGNzYyRkIKUldUN1l2Y3JQdHBPN0xrK05YR2J3bmwzVlh1dzN2c1NwRzloZC9sQjhubHB6cGt5L0c2THpNNDQK",
      "endpoints": [
        "https://github.com/kalebhenrique/sarue-unb/releases/latest/download/latest.json"
      ]
    }
  }
}
